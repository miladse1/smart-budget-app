# BudgetFlow configuration template.
#
# Copy this file to .env (which Git ignores) and fill in values on your own machine,
# in your own editor. Never paste real values into chat tools, issues, commits or docs.
# Leave the Plaid values blank to run in demo mode.

# development (local) or production. Production enforces https, an encryption key
# and a non-default database password, and hides the API docs.
APP_ENV=development

# Plaid keys from https://dashboard.plaid.com/developers/keys
# Use the Sandbox secret. Set both or neither.
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox or production. Keep sandbox. production is refused unless APP_ENV=production.
PLAID_ENV=sandbox

# Optional public https URL ending in /api/plaid/webhook (for example a tunnel).
# Leave blank to sync manually with the Sync button.
PLAID_WEBHOOK_URL=

# Local development database. Docker Compose overrides the host to "db".
# This default password is for local use only and is refused when APP_ENV=production.
DATABASE_URL=postgresql+psycopg://budgetflow:budgetflow@localhost:5432/budgetflow

# Fernet key that encrypts Plaid access tokens at rest. Generate one locally with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it private. If it is lost, connected banks must be connected again.
APP_ENCRYPTION_KEY=

# The one browser origin allowed to call the API. No wildcards.
FRONTEND_URL=http://localhost:5173
