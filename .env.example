# Copy this file to .env and fill in the values you need.
# BudgetFlow runs in demo mode when the Plaid values are left blank.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox, development, or production. Sandbox is the local default.
PLAID_ENV=sandbox

# Public URL Plaid can reach, for example a tunnel ending in /api/plaid/webhook.
# Leave blank until you want automatic sync.
PLAID_WEBHOOK_URL=

# Local backend (Docker Compose overrides the host to "db")
DATABASE_URL=postgresql+psycopg://budgetflow:budgetflow@localhost:5432/budgetflow

# Fernet key. Generate one with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=

# Browser origin allowed to call the API
FRONTEND_URL=http://localhost:5173
